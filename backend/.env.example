PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/ai-job-portal
JWT_SECRET=replace_with_a_secure_secret
GEMINI_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Firebase service-account credentials for manual platform jobs in Firestore.
# Use one of these credential options:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIRESTORE_JOBS_COLLECTION=jobs
