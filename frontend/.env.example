VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:5000
VITE_ENABLE_AFAI=true
VITE_ENABLE_RESUME_ANALYZER=true

# Optional: only needed for Firebase Auth / Google sign-in.
# Email/password login works through the Express JWT backend when these are empty.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
